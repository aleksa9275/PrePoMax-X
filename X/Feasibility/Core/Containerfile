FROM mcr.microsoft.com/dotnet/sdk:10.0

# Tool installation happens only when preparing the local test image.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 git \
    && rm -rf /var/lib/apt/lists/*

ARG PREPOMAX_X_RECIPE_SHA256
LABEL org.prepomaxx.core-probe.recipe-sha256=$PREPOMAX_X_RECIPE_SHA256

ENV DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_CLI_WORKLOAD_UPDATE_NOTIFY_DISABLE=1 \
    DOTNET_CLI_HOME=/tmp/dotnet \
    HOME=/tmp \
    GIT_CONFIG_COUNT=1 \
    GIT_CONFIG_KEY_0=safe.directory \
    GIT_CONFIG_VALUE_0=/workspace
WORKDIR /workspace
ENTRYPOINT ["python3", "X/Feasibility/Core/run-probe.py"]
