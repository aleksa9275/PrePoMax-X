<Project>
  <Import Project="../../Core/Directory.Build.props" />
  <PropertyGroup Condition="'$(NativePreviewLockRoot)' != ''">
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath>$(NativePreviewLockRoot)/$(MSBuildProjectName).json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
