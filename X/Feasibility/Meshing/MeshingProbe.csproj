<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PrePoMaxX.MeshingProbe</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NuGetAudit>false</NuGetAudit>
    <UpstreamSourceRoot Condition="'$(UpstreamSourceRoot)' == ''">$(MSBuildThisFileDirectory)../../..</UpstreamSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(UpstreamSourceRoot)/CaeMesh/Meshing/Transfinite/TransfiniteSideTriple.cs" Link="Upstream/TransfiniteSideTriple.cs" />
    <Compile Include="$(UpstreamSourceRoot)/CaeMesh/Meshing/Transfinite/ThreeBlockGrid.cs" Link="Upstream/ThreeBlockGrid.cs" />
  </ItemGroup>
</Project>
