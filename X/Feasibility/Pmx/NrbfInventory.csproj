<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PrePoMaxX.NrbfInventory</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <!-- Research-only trusted SDK decoder. No payload assemblies or production references. -->
  <ItemGroup>
    <Reference Include="System.Formats.Nrbf">
      <HintPath>$(MSBuildBinPath)/System.Formats.Nrbf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
