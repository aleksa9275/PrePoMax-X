<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PrePoMaxX.NrbfInventory</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NuGetAudit>false</NuGetAudit>
  </PropertyGroup>
  <!-- Keep historical offline research runs independent of the preview package. -->
  <ItemGroup Condition="'$(UseOfficialNrbf)' != 'true'">
    <Reference Include="System.Formats.Nrbf">
      <HintPath>$(MSBuildBinPath)/System.Formats.Nrbf.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="'$(UseOfficialNrbf)' == 'true'">
    <PackageReference Include="System.Formats.Nrbf" Version="[10.0.14]" />
  </ItemGroup>
</Project>
