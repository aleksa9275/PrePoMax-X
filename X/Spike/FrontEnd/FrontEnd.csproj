<Project Sdk="Microsoft.NET.Sdk">
  <!-- M3-1 toolkit spike (D065): the original PrePoMax (X/App) with an Avalonia front end in one .NET runtime - no
       Python, no GIL. It runs the original Program.Main; Application.Run hands FrmMain to this renderer. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework><Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings><AssemblyName>PrePoMaxX.FrontEndSpike</AssemblyName>
    <NuGetAudit>false</NuGetAudit><RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="[11.3.23]" />
    <PackageReference Include="Avalonia.Desktop" Version="[11.3.23]" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="[11.3.23]" />
    <ProjectReference Include="../../App/PrePoMax/PrePoMax.csproj" />
  </ItemGroup>
</Project>
