<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>disable</Nullable>
    <AssemblyName>PrePoMaxX.Workbench</AssemblyName><NuGetAudit>false</NuGetAudit><NoWarn>$(NoWarn);CS0436;CS0168;CS0169;CS0414;CS0649;CS0067;CA1416;SYSLIB0050</NoWarn>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(NativePreviewLockRoot)' != ''">$(NativePreviewLockRoot)/$(MSBuildProjectName).json</NuGetLockFilePath>
  </PropertyGroup>
  <ItemGroup><Using Remove="System.Threading" /></ItemGroup>
  <ItemGroup><ProjectReference Include="../../Domain/PrePoMax/PrePoMax.csproj" /><ProjectReference Include="../FormsCompat/FormsCompat.csproj" /></ItemGroup>
  <ItemGroup>
    <Compile Include="../../../PrePoMax/Forms/11_MeshSetup/Base/MeshSetupItemTypes.cs" Link="Original/MeshSetupItemTypes.cs" />
    <Compile Include="../../../PrePoMax/Forms/04_GeometryFeature/GeometryFeatureTypes.cs" Link="Original/GeometryFeatureTypes.cs" />
  </ItemGroup>
  <!-- The 3D view (M1): libvtkNative and the VTK libraries it loads (X/Build/Vtk/build.py runtime folder) go
       beside vtkControl.dll, as the original post-build copies vtkNative.dll and VTK into its lib folder -->
  <ItemGroup Condition="'$(VtkNativeRuntime)' != ''">
    <None Include="$(VtkNativeRuntime)/libvtk*;$(VtkNativeRuntime)/vtk*.dll;$(VtkNativeRuntime)/vtk-build.json;$(VtkNativeRuntime)/VTK-Copyright.txt"
          Exclude="$(VtkNativeRuntime)/vtkControl.*" LinkBase="." CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
