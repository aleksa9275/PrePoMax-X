# Local ARM64 GUI verification extension of the retained Phase B SDK/runtime image.
# Qt/VTK wheels keep the existing X/Desktop requirements-linux-arm64.txt pins.
FROM localhost/prepomaxx-phase-b-checks:arm64
RUN apt-get update && apt-get install -y --no-install-recommends libxcb-cursor0 libxkbcommon-x11-0 libxcb-icccm4 libxcb-keysyms1 libxcb-shape0 libxcb-xinerama0 libxcb-randr0 libxcb-render-util0 && rm -rf /var/lib/apt/lists/*
ENV QT_QPA_PLATFORM=xcb LANG=C.UTF-8
