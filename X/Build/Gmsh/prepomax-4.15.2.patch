+// the curvature of a face in the direction of a curve on it: the normal curvature
+// along the tangent t of the curve, k1 (t.d1)^2 + k2 (t.d2)^2 with the principal
+// curvatures k1, k2 and directions d1, d2 of the face (Euler); the maximum
+// curvature of the face where it gives no principal directions
+static double surf_curvature_along(const GFace *gf, const SPoint2 &par,
+                                   const SVector3 &t)
+{
+  SVector3 dirMax, dirMin;
+  double curvMax = 0., curvMin = 0.;
+  if(t.norm() == 0. ||
+     gf->curvatures(par, dirMax, dirMin, curvMax, curvMin) < 0. ||
+     dirMax.norm() == 0. || dirMin.norm() == 0.)
+    return gf->curvatureMax(par);
+  dirMax.normalize();
+  dirMin.normalize();
+  SVector3 tn = t;
+  tn.normalize();
+  double cMax = dot(tn, dirMax), cMin = dot(tn, dirMin);
+  double inPlane = cMax * cMax + cMin * cMin;
+  if(inPlane <= 0.) return gf->curvatureMax(par);
+  return std::abs(curvMax * cMax * cMax + curvMin * cMin * cMin) / inPlane;
+}
+
+// the largest curvature of the faces of a curve in its direction: a face that
+// bends across the curve only, a fillet along a straight edge, leaves the curve
+// at the size of the curve itself, while its maximum curvature would make the
+// whole edge as fine as the fillet is round
@@ -17,0 +45 @@
+  SVector3 t = ge->firstDer(u);
@@ -22 +50 @@
